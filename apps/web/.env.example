# Public site URL (used for QR links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Short QR domain, e.g. https://xx.plant (falls back to NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_QR_BASE_URL=

# Supabase (leave empty to use the local JSON store in .data/ for development)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notion sync
NOTION_TOKEN=
NOTION_DB_SPECIES=
NOTION_DB_FAMILIES=

# Payments (optional; cash-on-delivery works without any keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Admin area basic auth
ADMIN_USER=admin
ADMIN_PASSWORD=
# Salt for anonymous visitor hashing
ANALYTICS_SALT=change-me
