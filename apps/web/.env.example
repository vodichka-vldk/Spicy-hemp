# Public site URL (used for QR links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Short QR domain, e.g. https://xx.plant (falls back to NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_QR_BASE_URL=

# Supabase (leave empty to use the local JSON store in .data/ for development)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notion sync
NOTION_TOKEN=
NOTION_DB_SPECIES=c39319579e4a4e6eb40fc4581d757c16
NOTION_DB_FAMILIES=e5078d912368416b8e859eb0bf76bd6f

# Payments (optional; cash-on-delivery works without any keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Admin sign-in (e-mail + password). Without ADMIN_PASSWORD the admin is open in development and disabled in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: separate secret for signing the session cookie (defaults to a value derived from the password)
ADMIN_SESSION_SECRET=

# Telegram: notifications to the owner (bot token from @BotFather, chat id of the owner)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Bot username without @, enables the "My pot in Telegram" button on pot cards
NEXT_PUBLIC_TG_BOT=

# Nova Poshta: city/branch picker at checkout and automatic waybills (see docs/INTEGRATIONS.md)
NOVA_POSHTA_API_KEY=
NP_SENDER_CITY_REF=
NP_SENDER_REF=
NP_SENDER_ADDRESS_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_PHONE=
# Salt for anonymous visitor hashing
ANALYTICS_SALT=change-me
